# Used by docker-compose. Copy to .env and adjust.

# Studio back office: token the frontend uses to call admin APIs (min 24 chars) and Basic Auth for /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string-0000
ADMIN_USER=studio
ADMIN_PASSWORD=change-me

# Public URL of the frontend (payment return links point here).
FRONTEND_URL=http://localhost:3000
# Optional: return customers to brand domains after payment.
# PRODUCT_URLS=glossy=https://coverme.kz,shezhire=https://shezhire.kz,boardgame=https://mygame.kz
# Host -> brand mapping for production domains.
BRAND_DOMAINS=coverme.kz=glossy,shezhire.kz=shezhire,mygame.kz=boardgame

# AI drafts: "template" (no external calls) or "claude".
AI_GENERATOR=template
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

POSTGRES_PASSWORD=px

# Payments: "mock" (test page, no money) or "kaspi" (kaspi-pos sidecar + cashier session; see deploy/README.md).
PAYMENT_PROVIDER=mock
# KASPI_API_URL=http://127.0.0.1:3032
# KASPI_TOKEN_SN=
# KASPI_VTOKEN_SECRET=
# KASPI_PROFILE_ID=
# KASPI_WEBHOOK_SECRET=

# Photos: "local" (disk) or "s3" (any S3-compatible storage; the bucket may be shared, keys go under S3_PREFIX).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://object.pscloud.io
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_PREFIX=px/
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Voice studio: "browser" (scripted interviewer on the browser's speech recognition, no keys) or
# "elevenlabs" (live conversation with an ElevenLabs agent). Create the agent once:
#   cd services/voice && ELEVENLABS_API_KEY=… npm run provision   → prints ELEVENLABS_AGENT_ID
VOICE_PROVIDER=browser
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
