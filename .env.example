# Used by docker-compose. Copy to .env and adjust.

# Studio back office: token the frontend uses to call admin APIs (min 24 chars) and Basic Auth for /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string-0000
ADMIN_USER=studio
ADMIN_PASSWORD=change-me

# Public URL of the frontend (payment return links point here).
FRONTEND_URL=http://localhost:3000
# Host -> brand mapping for production domains.
BRAND_DOMAINS=coverme.kz=glossy,shezhire.kz=shezhire,mygame.kz=boardgame

# AI drafts: "template" (no external calls) or "claude".
AI_GENERATOR=template
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

POSTGRES_PASSWORD=px
