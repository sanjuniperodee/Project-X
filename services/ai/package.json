{
  "name": "@px/ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI: turns collected answers into an editorial draft (Claude) for designers",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@px/contracts": "file:../../shared/contracts",
    "@px/service-kit": "file:../../shared/service-kit"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
