# Address of the API gateway, used by the server (pages and the /api/* passthrough).
API_URL=http://localhost:8080

# Public URL of this site. The backend (projects/payments services) builds payment return links from it;
# the frontend itself derives absolute links from the request host.
FRONTEND_URL=http://localhost:3000

# Brand domains: host=productId, comma-separated. Leave empty in development: brands live under /glossy, /shezhire, /boardgame.
BRAND_DOMAINS=
# BRAND_DOMAINS=coverme.kz=glossy,shezhire.kz=shezhire,mygame.kz=boardgame

# Studio back-office (/admin): Basic Auth for people, bearer token for the gateway (must match the gateway's ADMIN_TOKEN).
ADMIN_USER=studio
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=dev-admin-token-change-me-please-32chars
